APP_NAME="CDM Career Recommendation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cdm_career_recommendation
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-google-account@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_TRUSTED_DEVICE_DAYS=30

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional path to a trusted PEM CA bundle. Leave empty to use system defaults.
# Windows local setup: tools/start-backend.ps1 prepares a bundle automatically.
# GOOGLE_CA_BUNDLE=

# Create a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

FRONTEND_URL=http://localhost:5173

# Portal operation settings
SESSION_TOKEN_MINUTES=720
CAMPUS_AUTH_PER_MINUTE=2000
MYSQLDUMP_BINARY=mysqldump

# Required before exam-taking is enabled: comma-separated campus public IPs/CIDRs.
# Leave empty to block all examination access. Results remain available everywhere.
EXAM_ALLOWED_NETWORKS=
# If behind a reverse proxy, list only its actual IPs/CIDRs; never use *.
EXAM_TRUSTED_PROXIES=
